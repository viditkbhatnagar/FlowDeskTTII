# FlowDesk — environment template.
#
# Copy to .env and fill in real values. NEVER commit .env (it is in .gitignore).
# On the droplet this file lives at /opt/flowdesk/.env with `chmod 600`.
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: VITE_* values are BAKED INTO THE CLIENT BUNDLE AT BUILD TIME.
# Setting them only at runtime does nothing for the browser. If any VITE_* value
# changes you must re-run `bun run build` and redeploy .output/.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server runtime ───────────────────────────────────────────────────────────

NODE_ENV=production

# Port the nitro node-server listens on. nginx proxies to this.
# 3100 is FlowDesk's allocated port — 3000 belongs to the CRM's API. Do not change
# it without also changing deploy/nginx/flowdesk.conf and deploy/ecosystem.config.cjs.
PORT=3100

# Bind to loopback only. nginx terminates TLS and is the only thing that should
# reach the Node process. Setting this to 0.0.0.0 would expose the app without TLS.
HOST=127.0.0.1


# ── Supabase (server-side) ───────────────────────────────────────────────────
# Read by the SSR server and the auth middleware.

# e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# The project ref on its own, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_ID=

# The PUBLISHABLE (anon) key — starts with `sb_publishable_`.
# This key is designed to be public and is protected by row-level security.
# Do NOT put a service-role key (`sb_secret_`) here: it bypasses RLS entirely and
# the application does not need one.
SUPABASE_PUBLISHABLE_KEY=


# ── Supabase (client bundle) ─────────────────────────────────────────────────
# Same three values again, exposed to the browser. Must match the server values.
# Baked in at build time — see the note at the top of this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=


# ── Email notifications ──────────────────────────────────────────────────────
# A background worker inside the SSR server queues and sends task emails
# (src/lib/email/worker.ts). It stays off unless EMAIL_WORKER_ENABLED=true, and a
# missing or bad setting only logs one line at boot — it never stops the web server.
# Password-reset codes are NOT sent by this worker: Supabase Auth sends them, using
# the template in deploy/email/ (see deploy/email/README.md).

# "true" to run the worker. Anything else leaves it off.
EMAIL_WORKER_ENABLED=

# Shared secret the worker presents to the email_worker_* database functions.
# At least 32 characters (e.g. `openssl rand -hex 32`). Store only its SHA-256 in the
# database (`printf %s "$EMAIL_WORKER_SECRET" | shasum -a 256`), never the secret itself:
#   INSERT INTO private.email_worker_config (id, secret_sha256)
#   VALUES (1, decode('<sha256 hex of the secret>', 'hex'))
#   ON CONFLICT (id) DO UPDATE SET secret_sha256 = EXCLUDED.secret_sha256, updated_at = now();
EMAIL_WORKER_SECRET=

# "graph" (Microsoft 365) or "log" (write each email to EMAIL_LOG_DIR as an .html file,
# for testing). Unset means graph when every MS_* value and MAIL_FROM_ADDRESS are set.
# The log transport marks every email it writes as SENT in the database it points at, so
# it is refused when NODE_ENV=production. Only against a LOCAL database, set
# EMAIL_LOG_ALLOW_PRODUCTION=true to run it under a production build anyway.
EMAIL_TRANSPORT=
EMAIL_LOG_DIR=
EMAIL_LOG_ALLOW_PRODUCTION=

# Microsoft Graph app-only credentials: the same Entra app registration as the CRM's
# mailer (Mail.Send application permission), but FlowDesk's own client secret (named
# "flowdesk"), never the CRM's. Its Application Access Policy must allow
# MAIL_FROM_ADDRESS (the "upCarrera Mailer Scope" group covers the Flowdesk mailbox).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The shared "Flowdesk" mailbox sends; replies go to MAIL_REPLY_TO (optional, one address).
# Microsoft shows the mailbox's own display name, whatever MAIL_FROM_NAME says.
MAIL_FROM_ADDRESS=flowdesk@upcarrera.com
MAIL_FROM_NAME=Flowdesk
MAIL_REPLY_TO=hello@upcarrera.com

# Public origin used for every link and the logo in emails. No trailing slash.
APP_URL=https://flowdesk.upcarrera.com

# How often the worker runs, in milliseconds. Default 300000 (5 min); minimum 60000.
# Each run sends at most 20 emails, 2.5 s apart; a Graph 429/5xx or a credentials
# problem pauses sending (without using up retries) and is logged once per reason.
EMAIL_WORKER_INTERVAL_MS=
