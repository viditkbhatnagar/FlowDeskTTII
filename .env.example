# FlowDesk — environment template.
#
# Copy to .env and fill in real values. NEVER commit .env (it is in .gitignore).
# On the droplet this file lives at /opt/flowdesk/.env with `chmod 600`.
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: VITE_* values are BAKED INTO THE CLIENT BUNDLE AT BUILD TIME.
# Setting them only at runtime does nothing for the browser. If any VITE_* value
# changes you must re-run `bun run build` and redeploy .output/.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server runtime ───────────────────────────────────────────────────────────

NODE_ENV=production

# Port the nitro node-server listens on. nginx proxies to this.
# 3100 is FlowDesk's allocated port — 3000 belongs to the CRM's API. Do not change
# it without also changing deploy/nginx/flowdesk.conf and deploy/ecosystem.config.cjs.
PORT=3100

# Bind to loopback only. nginx terminates TLS and is the only thing that should
# reach the Node process. Setting this to 0.0.0.0 would expose the app without TLS.
HOST=127.0.0.1


# ── Supabase (server-side) ───────────────────────────────────────────────────
# Read by the SSR server and the auth middleware.

# e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# The project ref on its own, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_ID=

# The PUBLISHABLE (anon) key — starts with `sb_publishable_`.
# This key is designed to be public and is protected by row-level security.
# Do NOT put a service-role key (`sb_secret_`) here: it bypasses RLS entirely and
# the application does not need one.
SUPABASE_PUBLISHABLE_KEY=


# ── Supabase (client bundle) ─────────────────────────────────────────────────
# Same three values again, exposed to the browser. Must match the server values.
# Baked in at build time — see the note at the top of this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=


# ── Not yet used ─────────────────────────────────────────────────────────────
# Email notifications (requirement R5) are NOT implemented. There is no mail
# transport in the codebase. Password recovery sends a Supabase OTP, which is
# blocked on an owned sending domain (docs/03). When that is built, the transport
# credentials belong here — and the CRM's existing Microsoft 365 / Graph
# integration in ~/codes/upcarrera-v2 should be preferred over a new provider.
